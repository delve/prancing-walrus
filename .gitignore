# random temporary crap
.tmp/

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
# WHAT? NO! i don't want to set up the workspace every time i start a gitpod!
# don't ignore these!
# go.work

# temp src copy to support import. because it's just easier.
importWalrusDb/sheetDAO
importWalrusDb/utility
importWalrusDb/devconfig.json
importWalrusDb/config.json
